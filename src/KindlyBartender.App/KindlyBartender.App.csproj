<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KindlyBartender.App</RootNamespace>
    <AssemblyName>KindlyBartender</AssemblyName>
    <!-- The LibraryImport source generator emits pointer code for Win32 calls; no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.Main runs Velopack's install hooks before WPF starts. -->
    <StartupObject>KindlyBartender.App.Program</StartupObject>
    <ApplicationIcon>Assets\KindlyBartender.ico</ApplicationIcon>
    <!-- ThemeMode (the Fluent theme) is marked experimental in .NET 10 but is the supported way to get it; DESIGN.md. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only NotifyIcon is used from Windows Forms; its implicit usings make WPF types such as Application and Point ambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- A page, not the application definition, so Program.Main can run first. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <!-- Copied next to the executable for the notification app ID's icon. -->
    <Content Include="Assets\KindlyBartender.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KindlyBartender.Core\KindlyBartender.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KindlyBartender.App.Tests" />
  </ItemGroup>

</Project>
